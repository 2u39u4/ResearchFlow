# LLM (required for smoke test LLM step)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-5.5
DEFAULT_LLM_PROVIDER=openai

# Optional: DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Semantic Scholar (optional; leave empty for anonymous ~1 req/s)
SEMANTIC_SCHOLAR_API_KEY=

# Crossref polite pool (recommended)
CROSSREF_MAILTO=your-email@example.com

# Paths
ATHENA_DATA_DIR=./data
ATHENA_CACHE_DIR=./athena_cache
ATHENA_DB_PATH=./data/athena.db

# Rate limits (seconds between requests)
ARXIV_MIN_INTERVAL_SEC=3.0
SEMANTIC_SCHOLAR_MIN_INTERVAL_SEC=1.0

# Citation validator
CITATION_TITLE_MATCH_THRESHOLD=90.0
CITATION_YEAR_TOLERANCE=1
CITATION_SEARCH_TOP_K=5

# Critic agent — leave CRITIC_LLM_MODEL empty to use DEFAULT_LLM_MODEL
# CRITIC_LLM_MODEL=gpt-5.5
CRITIC_TEMPERATURE=0.3
CRITIC_MAX_TOKENS=2048
CRITIC_MAX_CRITIQUES=8

# Planner / Writer (pipeline)
# PLANNER_LLM_MODEL=
# WRITER_LLM_MODEL=
PLANNER_TEMPERATURE=0.2
WRITER_TEMPERATURE=0.3

# LangGraph checkpoint DB
ATHENA_CHECKPOINT_DB=./data/athena_checkpoints.db

# Evaluation judge — use a different model/provider than the subject system
JUDGE_LLM_MODEL=gemini-3.5-flash
JUDGE_LLM_PROVIDER=gemini
EVAL_RANDOM_SEED=42
EVAL_DEFAULT_REPEATS=3

# Streamlit UI — set a password when exposing beyond localhost (empty = no gate)
ATHENA_UI_PASSWORD=

# Local PDF RAG (uploaded docs stay on-machine; never sent to scholarly APIs)
ATHENA_RAG_EMBEDDING_BACKEND=auto      # auto (semantic if installed, else hashing) | hashing | sentence-transformers
ATHENA_RAG_EMBEDDING_DIM=256           # hashing backend vector size
ATHENA_RAG_ST_MODEL=all-MiniLM-L6-v2   # sentence-transformers model (needs [rag] extra)
ATHENA_RAG_CHUNK_SIZE=800
ATHENA_RAG_CHUNK_OVERLAP=150
ATHENA_RAG_USE_FAISS=false             # FAISS acceleration (needs [rag] extra)
ATHENA_RAG_TOP_K=5

# Agent revision loop — re-research when too many citations fail verification
MAX_REVISIONS=1
REVISION_FAKE_THRESHOLD=0.34
