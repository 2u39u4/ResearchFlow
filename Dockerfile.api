FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt api/requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r api/requirements-api.txt
COPY athena ./athena
COPY app ./app
COPY api ./api
ENV PYTHONPATH=/app
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
